{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Blog post title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary of the post"
    },
    "content": {
      "type": "string",
      "description": "Full blog content in HTML"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "category": {
      "type": "string",
      "description": "Blog category"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Post tags"
    },
    "author_name": {
      "type": "string",
      "description": "Author display name"
    },
    "author_avatar": {
      "type": "string",
      "description": "Author avatar URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "reading_time": {
      "type": "number",
      "description": "Estimated reading time in minutes"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "content",
    "category"
  ]
}